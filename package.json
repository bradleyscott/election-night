{
  "name": "election-night",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w packages/dashboard",
    "build": "npm run build -w packages/dashboard",
    "start:collector": "npm run start -w packages/collector",
    "start:server": "npm run start -w packages/dashboard",
    "clear": "tsx packages/collector/src/clear.ts",
    "start:mock": "tsx packages/collector/src/serve-mock.ts",
    "log:webhooks": "tsx packages/collector/src/log-webhooks.ts",
    "test": "vitest",
    "lint": "eslint packages/",
    "lint:fix": "eslint packages/ --fix",
    "fmt": "prettier --write .",
    "typecheck": "tsc -b"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.12.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^4.1.8"
  }
}
