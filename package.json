{
  "name": "election-night",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w packages/web",
    "build": "npm run build -w packages/web",
    "start:cli": "npm run start -w packages/cli",
    "start:server": "npm run start -w packages/web",
    "start:mock": "npm run serve:mock -w packages/cli",
    "test": "vitest",
    "lint": "eslint packages/",
    "lint:fix": "eslint packages/ --fix",
    "fmt": "prettier --write .",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "eslint": "^9.18.0",
    "@eslint/js": "^9.18.0",
    "typescript-eslint": "^8.20.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4",
    "@types/node": "^22.12.0"
  }
}
