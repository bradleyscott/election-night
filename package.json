{
  "name": "election-night",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:core": "npm run build -w packages/core",
    "dev": "npm run build:core && npm run dev -w packages/dashboard",
    "build": "npm run build:core && npm run build -w packages/dashboard",
    "start:collector": "npm run build:core && npm run start -w packages/collector",
    "start:server": "npm run build:core && npm run start -w packages/dashboard",
    "clear": "tsx packages/collector/src/clear.ts",
    "start:mock": "npm run build:core && tsx packages/collector/src/serve-mock.ts",
    "log:webhooks": "tsx packages/collector/src/log-webhooks.ts",
    "test": "vitest",
    "lint": "eslint packages/",
    "lint:fix": "eslint packages/ --fix",
    "fmt": "prettier --write .",
    "typecheck": "npm run build:core && tsc -b && tsc -b packages/dashboard && tsc -p packages/dashboard/tsconfig.server.json",
    "prepare": "npm run build:core"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    },
    "vitest": {
      "vite": "^8.2.1"
    },
    "@vitest/mocker": {
      "vite": "^8.2.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.5",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.0.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.4.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.8"
  }
}
