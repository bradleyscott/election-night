# Standalone collector image. Reads the Electoral Commission XML feed over
# plain HTTPS and serves /health plus the unauthenticated /history/* REST API
# on port 3459 that the dashboard server reads via HISTORY_UPSTREAM.
#
# No browser and no Chromium: the XML feed is a cached static asset that is
# reachable from datacenter egress, so this image is small and can run
# anywhere.
#
# The production Fly.io deployment runs the dashboard server and the collector
# together from Dockerfile.app; this image is for running the collector alone.

FROM node:22 AS builder
WORKDIR /app

# Workspace package.json files first for layer-cached npm ci.
# npm ci validates every workspace listed in the root package.json against the
# lockfile, so packages/dashboard/package.json must exist even though this
# image never builds or ships the dashboard.
COPY package.json package-lock.json ./
COPY packages/core/package.json packages/core/
COPY packages/collector/package.json packages/collector/
COPY packages/dashboard/package.json packages/dashboard/

RUN npm ci --ignore-scripts && npm rebuild better-sqlite3

COPY tsconfig.base.json tsconfig.json ./
COPY packages/core/ packages/core/
COPY packages/collector/ packages/collector/

RUN npm run build:core

FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production

# Build revision for `election_build_info` (correlates graphs with deploys).
ARG GIT_SHA="unknown"
ENV GIT_SHA=$GIT_SHA

COPY --from=builder /app /app

# Health/live state endpoint + history REST API (unauthenticated;
# rate limiting happens at the reverse proxy when exposed).
EXPOSE 3459

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3459/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["npx", "tsx", "/app/packages/collector/src/index.ts"]
