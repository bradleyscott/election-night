# Collector-only image for homelab deployments (e.g. Coolify on a Proxmox LXC).
#
# Builds @election-night/core + the collector, installs the stealth Chromium,
# and runs the scraper loop. Outbound-only by default: the collector is a
# Socket.io *client* (publishes results to the cloud dashboard server), so no
# EXPOSE is declared. If the history REST endpoint (variant B) is added later,
# uncomment the EXPOSE line and map it in Coolify.
#
# Mirrors the root Dockerfile's build pattern (prebuilt better-sqlite3,
# cloakbrowser install, tsx runtime) so what works in Fly CI works here.

FROM node:22 AS builder
WORKDIR /app

ENV CLOAKBROWSER_CACHE_DIR=/app/.cloakbrowser
ENV CLOAKBROWSER_AUTO_UPDATE=false

# Workspace package.json files first for layer-cached npm ci.
# npm ci validates every workspace listed in the root package.json against the
# lockfile, so packages/dashboard/package.json must exist even though we never
# build or ship the dashboard in this image.
COPY package.json package-lock.json ./
COPY packages/core/package.json packages/core/
COPY packages/collector/package.json packages/collector/
COPY packages/dashboard/package.json packages/dashboard/

RUN npm ci --ignore-scripts && \
    npm rebuild better-sqlite3 && \
    cd packages/collector && npx cloakbrowser install && cd /app

COPY tsconfig.base.json tsconfig.json ./
COPY packages/core/ packages/core/
COPY packages/collector/ packages/collector/
COPY csv/ csv/

RUN npm run build:core

FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production
ENV CLOAKBROWSER_CACHE_DIR=/app/.cloakbrowser
ENV CLOAKBROWSER_AUTO_UPDATE=false

# Runtime deps for the stealth Chromium (same list as the root Dockerfile).
RUN apt-get update && apt-get install -y \
  wget \
  ca-certificates \
  fonts-liberation \
  libasound2 \
  libatk-bridge2.0-0 \
  libatk1.0-0 \
  libcairo2 \
  libcups2 \
  libdbus-1-3 \
  libdrm2 \
  libgbm1 \
  libglib2.0-0 \
  libgtk-3-0 \
  libnspr4 \
  libnss3 \
  libpango-1.0-0 \
  libpangocairo-1.0-0 \
  libx11-6 \
  libx11-xcb1 \
  libxcb1 \
  libxcomposite1 \
  libxcursor1 \
  libxdamage1 \
  libxext6 \
  libxfixes3 \
  libxi6 \
  libxrandr2 \
  libxrender1 \
  libxss1 \
  --no-install-recommends \
  && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app /app

# Optional: expose the history REST endpoint once implemented (see README).
# EXPOSE 3459

CMD ["npx", "tsx", "/app/packages/collector/src/index.ts"]
