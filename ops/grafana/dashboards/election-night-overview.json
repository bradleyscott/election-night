          "editorMode": "code",
          "expr": "sum(rate(election_scrape_duration_seconds_count[$__rate_interval])) * 60",
          "legendFormat": "cycles/min",
          "range": true,
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "id": 5
    },
