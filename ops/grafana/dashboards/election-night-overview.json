          "editorMode": "code",
          "expr": "election_electorates_reporting / election_electorates_total",
          "legendFormat": "",
          "range": true,
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "id": 3
    },
