# dockerignore patterns without a leading slash are anchored to the
# context root, so use **/ for anything that also appears nested under
# packages/* (node_modules, .cache, .data, dist)
**/node_modules
**/.cache
**/.data
**/dist
# tsbuildinfo can linger locally from incremental builds; if it ships in the
# context while dist is excluded, tsc -b treats the project as up-to-date and
# skips emitting dist
**/*.tsbuildinfo
.git
.gitignore
.env
.env.*
!.env.example
.vscode
*.md
.DS_Store
coverage
