# Reference env vars for the homelab collector (paste these into the Coolify
# application's "Environment Variables" tab — no .env file is read in the
# container; Coolify injects them and dotenv never overrides injected values).

# Scraping — the real NZ Electoral Commission results site.
BASE_RESULTS_URL=https://www.electionresults.govt.nz/electionresults_2023

# Runtime
POLL_INTERVAL_MS=120000
CONCURRENCY=10
NAVIGATION_TIMEOUT_MS=120000
FETCH_PACING_MS=300
CHALLENGE_WARMUP_TIMEOUT_MS=180000
CHALLENGE_WARMUP_MAX_ATTEMPTS=3
# Skip the warm-up on trusted home egress — the site serves results directly.
CHALLENGE_WARMUP_ENABLED=false
LOG_LEVEL=3
# Health/live state endpoint served by the collector (Coolify healthcheck).
# Also hosts the /history/* REST endpoints that the cloud dashboard server
# reads — set the SAME token on the cloud server (HISTORY_TOKEN there too).
# Loopback callers are trusted without a token; unset = remote requests 404.
HEALTH_PORT=3459
HISTORY_TOKEN=
WS_RECONNECT_DELAY_MS=2000

# The cloud dashboard server this collector publishes to (the Socket.io hub).
# Use https:// so socket.io-client upgrades to wss.
WS_URL=https://election-night.fly.dev

# Database (mounted persistent volume — see README).
DB_PATH=/app/.data/election_results.db

# Browser (cloakbrowser)
CLOAKBROWSER_HEADLESS=true
CLOAKBROWSER_HUMANIZE=true
CLOAKBROWSER_GEOIP=false
# Optional residential proxy if the home connection itself gets WAF-blocked.
CLOAKBROWSER_PROXY=

# Shared secret between collector and server. Set the SAME value on both sides
# (collector env here + SOCKET_TOKEN in the cloud server's fly.toml). Required
# once the socket-auth gate lands; harmless to set now.
SOCKET_TOKEN=

# Optional webhook (single URL; payload includes an `event` field).
WEBHOOK_URL=

# Optional custom source adapter (JS/TS module path).
ELECTION_SOURCE_PATH=
