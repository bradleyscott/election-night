# Source (official Electoral Commission XML feed)
# Builds https://electionresults.govt.nz/electionresults_<year>/xml/
ELECTION_YEAR=2023
# Optional full override for the XML feed base URL (must end with /).
# Takes precedence over ELECTION_YEAR; useful for the mock XML server.
XML_FEED_BASE_URL=

# Runtime
POLL_INTERVAL_MS=120000
CONCURRENCY=10
# Per-request HTTP timeout for XML feed fetches
FETCH_TIMEOUT_MS=30000
FETCH_PACING_MS=300
LOG_LEVEL=3
WS_RECONNECT_DELAY_MS=2000

# Collector health/live-state endpoint. Also hosts the /history/* REST
# endpoints that the dashboard server reads. Public election data; rate
# limit at the proxy if you expose it.
HEALTH_PORT=3459

# Socket.io
WS_PORT=3456
WS_URL=

# Database
DB_PATH=.data/election_results.db
# JSON cache of the current cycle's electorate results (webhook diff baseline).
# Tagged with ELECTION_YEAR: a cache left over from a different cycle is
# ignored rather than diffed against, so the first scrape of a new cycle does
# not fire a burst of bogus events.
RESULTS_CACHE_PATH=.data/electorate_results.json

# Custom source adapter (a module exporting an ElectionSource)
ELECTION_SOURCE_PATH=

# Webhook (single URL; payload includes an `event` field to discriminate type)
WEBHOOK_URL=
# Local webhook receiver port (npm run log:webhooks)
WEBHOOK_LOG_PORT=3458

# Mock XML results server port (npm run start:mock)
MOCK_PORT=3457
# Which cycle's electorate list the mock replays: 2023 (65 general + 7 Maori)
# or 2026 (64 + 7, with the 2025 boundary changes). Overridden by --year.
MOCK_ELECTION_YEAR=2023

# Combined dashboard+collector image. Set false to run the
# dashboard alone (PR previews do this so they never poll the live feed).
COLLECTOR_ENABLED=true

# Dashboard web server
DIST_DIR=
CACHE_PATH=.data/electorate_results.json
FEED_CACHE_PATH=.data/feed_events.json
MAX_FEED_EVENTS=200
# When set, POST /api/clear requires this shared secret in the x-clear-token
# header. Leave unset to keep the clear endpoint open (not recommended).
CLEAR_TOKEN=
# Frontend Socket.io URL override (defaults to the current origin)
VITE_WS_URL=
# Frontend electorate boundary dataset to draw. Boundaries are keyed by election
# year in packages/dashboard/public/boundaries/. When unset the map picks the
# year whose electorate names match the results it is rendering (so dev against
# 2023 data draws 2023 boundaries). Set this to pin the cycle, e.g. 2026.
VITE_ELECTION_YEAR=

# History API — always fetched from the collector's /history/* REST API.
# For the co-located deployment this is loopback.
HISTORY_UPSTREAM=http://127.0.0.1:3459

# Build metadata exposed as election_build_info on both processes (defaults:
# dev / unknown). CI passes the commit SHA as a Docker build arg (see
# .github/workflows/deploy.yml).
# APP_VERSION=dev
# GIT_SHA=unknown
