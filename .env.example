# Source (official Electoral Commission XML feed)
# Builds https://electionresults.govt.nz/electionresults_<year>/xml/
ELECTION_YEAR=2023
# Optional full override for the XML feed base URL (must end with /).
# Takes precedence over ELECTION_YEAR; useful for the mock XML server.
XML_FEED_BASE_URL=

# Runtime
# The feed is CDN-cached with max-age 30s and a full cycle takes about a
# second, so polling faster than the CDN refreshes gains nothing.
POLL_INTERVAL_MS=30000
CONCURRENCY=10
# Per-request HTTP timeout for XML feed fetches (responses are ~13ms; this is
# a hang guard, not a latency budget)
FETCH_TIMEOUT_MS=5000
LOG_LEVEL=3

# Database
DB_PATH=.data/election_results.db


# Webhook (single URL; payload includes an `event` field to discriminate type)
WEBHOOK_URL=
# Local webhook receiver port (npm run log:webhooks)
WEBHOOK_LOG_PORT=3458

# Mock XML results server port (npm run start:mock)
MOCK_PORT=3457
# Which cycle's electorate list the mock replays: 2023 (65 general + 7 Maori)
# or 2026 (64 + 7, with the 2025 boundary changes). Overridden by --year.
MOCK_ELECTION_YEAR=2023

# Run the in-process collector loop. false serves the last written snapshot
# without polling (PR previews do this so they never hit the live feed).
COLLECTOR_ENABLED=true

# Dashboard web server
# Public HTTP + Socket.io port (serves the built UI and the live results feed)
WS_PORT=3456
DIST_DIR=
FEED_CACHE_PATH=.data/feed_events.json
MAX_FEED_EVENTS=200
# Frontend electorate boundary dataset to draw. Boundaries are keyed by election
# year in packages/dashboard/public/boundaries/. When unset the map picks the
# year whose electorate names match the results it is rendering (so dev against
# 2023 data draws 2023 boundaries). Set this to pin the cycle, e.g. 2026.
VITE_ELECTION_YEAR=
